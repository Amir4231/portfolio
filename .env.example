# Local SQLite (Turso) database
TURSO_DATABASE_URL=file:./local.db

# Production (uncomment and fill in when you create a Turso database)
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# Admin password for /admin (REQUIRED — change this before deploying)
ADMIN_PASSWORD=change-me

# Secret key used to sign the admin session cookie (REQUIRED in production — generate with: openssl rand -hex 32)
SESSION_SECRET=some-32-byte-hex-random-secret
