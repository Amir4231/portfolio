---
import { Moon, Sun } from "@lucide/astro";
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  class="theme-toggle inline-flex size-9 items-center justify-center rounded-md text-muted transition hover:text-ink"
>
  <Sun class="size-5 dark:hidden" />
  <Moon class="hidden size-5 dark:block" />
</button>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".theme-toggle");
  const meta = document.querySelector('meta[name="theme-color"]');
  const applyColor = (dark: boolean) =>
    meta?.setAttribute("content", dark ? "#0e0c0a" : "#f4efe6");
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch (e) {}
      applyColor(dark);
    }),
  );
</script>
