---
import { resolveSite } from "../data/site";
import { MapPin } from "@lucide/astro";

const site = resolveSite(Astro.locals.settings);
---

<section id="contact" class="scroll-mt-20" data-reveal>
  <h2 class="font-serif text-3xl font-semibold tracking-tight text-ink text-balance sm:text-4xl">
    Let's build something together
  </h2>
  <p class="mt-4 max-w-xl text-lg text-muted">
    Open to full-time roles, contract work, and collaboration. The fastest
    way to reach me is email.
  </p>
  <a
    href={`mailto:${site.email}?subject=Let's%20work%20together`}
    class="link-sweep mt-7 inline-block font-serif text-2xl font-semibold text-accent sm:text-3xl"
  >
    {site.email}
  </a>
  <p class="mt-3 flex items-center gap-1.5 text-sm text-faint">
    <MapPin class="size-4" />
    {site.location}
  </p>
</section>
