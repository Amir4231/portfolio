---
import { resolveSite } from "../data/site";
import { ArrowRight, Mail } from "@lucide/astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import XIcon from "./icons/XIcon.astro";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";

const site = resolveSite(Astro.locals.settings);

const socials = [
  { href: site.github, label: "GitHub", icon: GithubIcon },
  { href: site.linkedin, label: "LinkedIn", icon: LinkedinIcon },
  { href: site.twitter, label: "X", icon: XIcon },
];
if (site.whatsapp) {
  socials.push({ href: site.whatsapp, label: "WhatsApp", icon: WhatsAppIcon });
}
---

<section>
  <div class="mx-auto max-w-6xl px-4 pb-16 pt-20 sm:px-6 sm:pb-24 sm:pt-28">
    <p class="text-sm text-faint" data-reveal>
      {site.location} · Available for work
    </p>

    <div class="mt-7 flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <h1
        class="max-w-3xl font-serif text-5xl font-semibold leading-[1.04] tracking-tight text-ink text-balance sm:text-6xl md:text-7xl"
        data-reveal
        data-reveal-delay="0.05"
      >
        {site.name}
        <span class="text-faint"> — {site.role}</span>
      </h1>

      {site.avatar && (
        <img
          src={site.avatar}
          alt=""
          width="160"
          height="160"
          loading="eager"
          decoding="async"
          class="size-32 shrink-0 rounded-full border border-line object-cover sm:size-40"
          data-reveal
          data-reveal-delay="0.1"
        />
      )}
    </div>

    <p
      class="mt-8 max-w-xl text-lg leading-relaxed text-muted"
      data-reveal
      data-reveal-delay="0.1"
    >
      {site.tagline}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-8" data-reveal data-reveal-delay="0.15">
      <a
        href="#projects"
        class="inline-flex items-center gap-2 rounded-sm bg-accent px-6 py-3.5 text-sm font-semibold text-surface transition hover:opacity-90"
      >
        View selected work
        <ArrowRight class="size-4" />
      </a>
      <a
        href={`mailto:${site.email}?subject=Let's%20work%20together`}
        class="link-sweep text-sm font-semibold text-ink"
      >
        Get in touch
      </a>
    </div>

    <div
      class="mt-16 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-line pt-6 text-sm"
      data-reveal
      data-reveal-delay="0.2"
    >
      <a
        href={`mailto:${site.email}`}
        class="flex items-center gap-2 text-faint transition hover:text-ink"
      >
        <Mail class="size-4" />
        {site.email}
      </a>
      <div class="flex items-center gap-1.5">
        {socials.map(({ href, label, icon: Icon }) => (
          <a
            href={href}
            aria-label={label}
            rel="noopener noreferrer"
            target="_blank"
            class="inline-flex size-9 items-center justify-center rounded-md text-faint transition hover:bg-line/60 hover:text-ink"
          >
            <Icon class="size-[18px]" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>