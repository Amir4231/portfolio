---
import { site } from "../data/site";
import { ArrowRight } from "@lucide/astro";

const links = [
  { href: `mailto:${site.email}`, label: site.email },
  { href: site.github, label: "GitHub" },
  { href: site.linkedin, label: "LinkedIn" },
  { href: site.twitter, label: "X" },
];
---

<section>
  <div class="mx-auto max-w-6xl px-4 pb-16 pt-20 sm:px-6 sm:pb-24 sm:pt-28">
    <p class="text-sm text-faint" data-reveal>
      {site.location} · Available for work
    </p>

    <h1
      class="mt-7 max-w-4xl font-serif text-5xl font-semibold leading-[1.04] tracking-tight text-ink text-balance sm:text-6xl md:text-7xl"
      data-reveal
      data-reveal-delay="0.05"
    >
      {site.name}
      <span class="text-faint"> — {site.role}</span>
    </h1>

    <p
      class="mt-8 max-w-xl text-lg leading-relaxed text-muted"
      data-reveal
      data-reveal-delay="0.1"
    >
      {site.tagline}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-8" data-reveal data-reveal-delay="0.15">
      <a
        href="#projects"
        class="inline-flex items-center gap-2 rounded-sm bg-accent px-6 py-3.5 text-sm font-semibold text-surface transition hover:opacity-90"
      >
        View selected work
        <ArrowRight class="size-4" />
      </a>
      <a
        href={`mailto:${site.email}?subject=Let's%20work%20together`}
        class="link-sweep text-sm font-semibold text-ink"
      >
        Get in touch
      </a>
    </div>

    <div
      class="mt-16 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-line pt-6 text-sm"
      data-reveal
      data-reveal-delay="0.2"
    >
      {links.map((link) => (
        <a
          href={link.href}
          class="text-faint transition hover:text-ink"
          {...(link.href.startsWith("http")
            ? { rel: "noopener noreferrer", target: "_blank" }
            : {})}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>
