---
/**
 * Desk3D.astro — lazy-loaded interactive Spline scene.
 *
 * - Client-side only init via IntersectionObserver (no SSR WebGL).
 * - Tailwind skeleton loader, faded out with GSAP on ready.
 * - Strict WebGL cleanup on unmount / page swap.
 */
export interface Props {
  /** Full URL to the `.splinecode` scene (required). */
  sceneUrl: string;
  /** Accessible label for the canvas region. */
  title?: string;
  /** Extra Tailwind classes merged onto the wrapper. */
  class?: string;
  /**
   * Render resolution scale (0.5–1). Lower = fewer backing-store
   * pixels = faster. Defaults to auto: 1 on DPR-1 displays,
   * ~1/DPR on HiDPI (clamped to 0.5).
   */
  renderScale?: number;
}

const {
  sceneUrl,
  title = "Interactive 3D desk scene",
  class: className = "",
  renderScale,
} = Astro.props;

if (!sceneUrl || typeof sceneUrl !== "string") {
  throw new Error("[Desk3D] `sceneUrl` prop is required and must be a string.");
}

const instanceId = `desk3d-${Math.random().toString(36).slice(2, 10)}`;
---

<div
  id={instanceId}
  data-desk3d-root
  data-scene-url={sceneUrl}
  data-render-scale={renderScale ?? ""}
  role="img"
  aria-label={title}
  aria-busy="true"
  class={`desk3d-root relative w-full h-[450px] md:h-[600px] overflow-hidden rounded-2xl border border-white/10 bg-black/40 shadow-[0_8px_40px_-12px_rgba(0,0,0,0.6)] backdrop-blur-md ${className}`}
>
  <canvas
    data-desk3d-canvas
    class="absolute inset-0 block h-full w-full opacity-0"
    aria-hidden="true"
  ></canvas>

  <!-- Skeleton loader (visible until Spline reports ready) -->
  <div
    data-desk3d-loader
    class="absolute inset-0 flex flex-col justify-end gap-4 p-6 sm:p-8"
    aria-hidden="true"
  >
    <div class="absolute inset-0 bg-gradient-to-b from-white/[0.04] via-transparent to-black/30"></div>
    <div class="desk3d-shimmer absolute inset-0"></div>
    <div class="relative space-y-3">
      <div class="h-3 w-2/5 animate-pulse rounded-full bg-white/15"></div>
      <div class="h-3 w-3/5 animate-pulse rounded-full bg-white/10 [animation-delay:150ms]"></div>
      <div class="mt-5 flex items-center gap-3">
        <div class="size-8 animate-pulse rounded-full bg-white/15"></div>
        <div class="h-2.5 w-24 animate-pulse rounded-full bg-white/10 [animation-delay:300ms]"></div>
        <div class="ml-auto flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.2em] text-white/40">
          <span class="size-1.5 animate-ping rounded-full bg-white/50"></span>
          Loading 3D
        </div>
      </div>
    </div>
  </div>

  <!-- Error fallback (revealed only on load failure) -->
  <div
    data-desk3d-error
    hidden
    class="absolute inset-0 hidden flex-col items-center justify-center gap-2 p-6 text-center"
  >
    <p class="text-sm font-medium text-white/70">3D scene could not be loaded.</p>
    <p class="text-xs text-white/40">Check your connection and scroll back to retry.</p>
  </div>
</div>

<style>
  .desk3d-shimmer {
    background: linear-gradient(
      100deg,
      transparent 20%,
      rgba(255, 255, 255, 0.06) 40%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.06) 60%,
      transparent 80%
    );
    background-size: 200% 100%;
    animation: desk3d-shimmer 1.8s linear infinite;
  }
  @keyframes desk3d-shimmer {
    from { background-position: 200% 0; }
    to { background-position: -200% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .desk3d-shimmer { animation: none; }
  }
  /* setSize() makes the runtime set inline canvas dimensions; keep the
     canvas filling the wrapper and let the GPU upscale the smaller
     backing store instead. */
  .desk3d-root canvas[data-desk3d-canvas] {
    width: 100% !important;
    height: 100% !important;
  }
</style>

<script>
  // Runs browser-only. Initialises every <Desk3D> instance lazily on viewport entry.
  const roots = document.querySelectorAll("[data-desk3d-root]");

  const cleanups = new Set<() => void>();

  function forceLoseContext(canvas: HTMLCanvasElement) {
    try {
      const gl =
        canvas.getContext("webgl2", { failIfMajorPerformanceCaveat: false }) ??
        canvas.getContext("webgl", { failIfMajorPerformanceCaveat: false });
      (gl?.getExtension("WEBGL_lose_context") as { loseContext?: () => void } | null)?.loseContext?.();
    } catch {
      // Non-fatal: context already gone or unavailable.
    }
  }

  function initRoot(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>("[data-desk3d-canvas]");
    const loader = root.querySelector<HTMLElement>("[data-desk3d-loader]");
    const errorBox = root.querySelector<HTMLElement>("[data-desk3d-error]");
    const sceneUrl = root.dataset.sceneUrl;
    if (!canvas || !loader || !sceneUrl) return;

    let disposed = false;
    let app: {
      dispose: () => void;
      setSize: (width: number, height: number) => void;
      stop: () => void;
      play: () => void;
    } | null = null;
    let observer: IntersectionObserver | null = null;
    let visibilityObserver: IntersectionObserver | null = null;
    let detachGuard: MutationObserver | null = null;
    let resizeObserver: ResizeObserver | null = null;
    let resizeTimer: number | null = null;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Cap the render backing store: Spline runs its fullscreen post
    // chain (AO, bloom, noise, vignette, AA) at backing resolution, so
    // pixels ~= cost. Auto mode targets ~1 backing px per CSS px.
    function resolveRenderScale(): number {
      const override = Number(root.dataset.renderScale);
      if (Number.isFinite(override) && override > 0) {
        return Math.min(1, Math.max(0.5, override));
      }
      const dpr = window.devicePixelRatio || 1;
      return Math.min(1, Math.max(0.5, 1 / dpr));
    }

    function applyRenderScale() {
      if (!app || !canvas || disposed) return;
      try {
        const scale = resolveRenderScale();
        const w = Math.max(1, Math.floor(canvas.clientWidth * scale));
        const h = Math.max(1, Math.floor(canvas.clientHeight * scale));
        app.setSize(w, h);
      } catch {
        // Best-effort only; the scene still renders at default resolution.
      }
    }

    function dispose() {
      if (disposed) return;
      disposed = true;
      observer?.disconnect();
      detachGuard?.disconnect();
      visibilityObserver?.disconnect();
      resizeObserver?.disconnect();
      observer = null;
      detachGuard = null;
      visibilityObserver = null;
      resizeObserver = null;
      if (resizeTimer !== null) {
        window.clearTimeout(resizeTimer);
        resizeTimer = null;
      }
      try {
        app?.dispose();
      } catch {
        // dispose() is idempotent-safe; ignore post-unmount errors.
      } finally {
        app = null;
      }
      forceLoseContext(canvas!);
      cleanups.delete(dispose);
    }

    cleanups.add(dispose);

    // Strict unmount cleanup: DOM removal, page hide, Astro view-transition swap.
    if (typeof MutationObserver !== "undefined" && root.parentNode) {
      detachGuard = new MutationObserver(() => {
        if (!root.isConnected) dispose();
      });
      detachGuard.observe(root.parentNode, { childList: true });
    }
    window.addEventListener("pagehide", dispose, { once: true });
    document.addEventListener("astro:before-swap", dispose, { once: true });

    async function boot() {
      try {
        const [{ Application }, { default: gsap }] = await Promise.all([
          import("@splinetool/runtime"),
          import("gsap"),
        ]);
        if (disposed || !root.isConnected) return;

        const spline = new Application(canvas!);
        app = spline;
        await spline.load(sceneUrl!);
        if (disposed || !root.isConnected) {
          dispose();
          return;
        }

        root.setAttribute("aria-busy", "false");
        applyRenderScale();

        // setSize() disables Spline's auto-resize; track the wrapper instead.
        if (typeof ResizeObserver !== "undefined") {
          resizeObserver = new ResizeObserver(() => {
            if (resizeTimer !== null) window.clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(applyRenderScale, 150);
          });
          resizeObserver.observe(root);
        }

        // Pause rendering when scrolled out of view: a heavy canvas
        // competing with the compositor is the classic scroll-jank source.
        // Any visible pixel resumes playback; state is mirrored for debugging.
        if ("IntersectionObserver" in window) {
          visibilityObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!app || disposed) return;
                try {
                  if (entry.isIntersecting) {
                    app.play();
                    root.dataset.renderState = "playing";
                  } else {
                    app.stop();
                    root.dataset.renderState = "paused";
                  }
                } catch {
                  // Pause is best-effort; rendering continues if it fails.
                }
              }
            },
            { threshold: 0 }
          );
          visibilityObserver.observe(root);
        }

        if (reduceMotion) {
          loader!.style.display = "none";
          canvas!.style.opacity = "1";
        } else {
          gsap.to(canvas!, { autoAlpha: 1, duration: 0.8, ease: "power2.out" });
          gsap.to(loader!, {
            autoAlpha: 0,
            duration: 0.6,
            ease: "power2.inOut",
            onComplete: () => {
              loader!.style.display = "none";
            },
          });
          gsap.fromTo(
            root,
            { y: 12, scale: 0.995 },
            { y: 0, scale: 1, duration: 0.8, ease: "power2.out" }
          );
        }
      } catch (err) {
        console.error("[Desk3D] Failed to load Spline scene:", err);
        if (disposed) return;
        loader!.style.display = "none";
        if (errorBox) {
          errorBox.hidden = false;
          errorBox.classList.remove("hidden");
          errorBox.classList.add("flex");
        }
        root.setAttribute("aria-busy", "false");
        dispose();
      }
    }

    if (!("IntersectionObserver" in window)) {
      void boot();
      return;
    }

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            observer?.disconnect();
            observer = null;
            void boot();
            break;
          }
        }
      },
      { rootMargin: "200px 0px", threshold: 0.05 }
    );
    observer.observe(root);
  }

  roots.forEach((root) => initRoot(root as HTMLElement));

  // Safety net for full-page teardown (HMR / navigation without view transitions).
  window.addEventListener(
    "beforeunload",
    () => {
      cleanups.forEach((fn) => fn());
    },
    { once: true }
  );
</script>
