---
import type { Achievement } from "../lib/types";
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  achievement: Achievement;
  delay?: number;
}

const { achievement, delay = 0 } = Astro.props;
---

<article class="border-t border-line" data-reveal data-reveal-delay={delay}>
  <div class="group py-6 sm:py-7">
    <div class="flex items-baseline justify-between gap-4">
      <span class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">
        {achievement.category}
      </span>
      <span class="text-xs text-faint">{achievement.date}</span>
    </div>

    <div class="mt-2.5 flex items-start justify-between gap-4">
      <h3 class="font-serif text-lg font-semibold text-ink">
        <a
          href={`/achievements/${achievement.id}/`}
          class="transition hover:text-accent"
        >
          {achievement.title}
        </a>
      </h3>
      <a
        href={`/achievements/${achievement.id}/`}
        aria-label={`${achievement.title} — details`}
        class="mt-1 shrink-0 text-faint transition group-hover:text-accent"
      >
        <ArrowUpRight class="size-5" />
      </a>
    </div>
    <p class="text-sm text-faint">{achievement.issuer}</p>

    <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-muted">
      {achievement.description}
    </p>

    <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-sm">
      {achievement.highlightMetric && (
        <span class="font-mono font-medium text-accent">
          {achievement.highlightMetric}
        </span>
      )}
      {achievement.credentialUrl && (
        <a
          href={achievement.credentialUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center gap-1 text-xs text-faint transition hover:text-accent"
        >
          Verify
          <ArrowUpRight class="size-3.5" />
        </a>
      )}
      {achievement.images.length > 0 && (
        <span class="text-xs text-faint">
          {achievement.images.length} image{achievement.images.length === 1 ? "" : "s"}
        </span>
      )}
    </div>
  </div>
</article>
