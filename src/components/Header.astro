---
import { site } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";
import { Menu } from "@lucide/astro";

const nav = [
  { href: "/#projects", label: "Work" },
  { href: "/#achievements", label: "Milestones" },
  { href: "/#skills", label: "Stack" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-surface/85 backdrop-blur-md">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6"
    aria-label="Primary"
  >
    <a
      href="/"
      class="font-serif text-lg font-semibold tracking-tight text-ink"
    >
      {site.name}
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class="link-sweep text-sm font-medium text-muted transition hover:text-ink"
        >
          {item.label}
        </a>
      ))}
      <a
        href={site.resume}
        class="text-sm font-medium text-accent transition hover:opacity-80"
      >
        Resume
      </a>
      <ThemeToggle />
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex size-9 items-center justify-center rounded-md text-muted transition hover:text-ink"
      >
        <Menu class="size-5" />
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="hidden border-t border-line px-4 py-3 md:hidden"
  >
    <div class="flex flex-col gap-1">
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded-md px-3 py-2 text-sm font-medium text-muted transition hover:text-ink"
        >
          {item.label}
        </a>
      ))}
      <a
        href={site.resume}
        class="px-3 py-2 text-sm font-medium text-accent transition hover:opacity-80"
      >
        Resume
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const hidden = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!hidden));
  });
</script>
