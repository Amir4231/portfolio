---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ArrowLeft, ArrowUpRight, Calendar } from "@lucide/astro";
import GithubIcon from "../../components/icons/GithubIcon.astro";
import { getProjectImage, isExternalImage } from "../../lib/images";
import { getProject } from "../../lib/db";
import { renderMarkdown } from "../../lib/markdown";

const slug = Astro.params.slug ?? "";
const project = await getProject(slug);

if (!project) {
  return Astro.redirect("/projects");
}

const { title, description, pubDate, tags, heroImage, githubUrl, liveUrl, body } =
  project;
const image = getProjectImage(heroImage);
const external = isExternalImage(heroImage);
const formattedDate = pubDate
  ? new Date(pubDate).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";
const html = renderMarkdown(body);
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <a
      href="/projects/"
      class="link-sweep inline-flex items-center gap-1.5 text-sm font-medium text-muted"
    >
      <ArrowLeft class="size-4" />
      All projects
    </a>

    <header class="mt-8" data-reveal>
      <h1
        class="font-serif text-3xl font-semibold tracking-tight text-ink text-balance sm:text-4xl md:text-5xl"
      >
        {title}
      </h1>
      <p class="mt-4 text-lg text-muted">{description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
        {formattedDate && (
          <span class="flex items-center gap-1.5 text-faint">
            <Calendar class="size-4" />
            {formattedDate}
          </span>
        )}
        {githubUrl && (
          <a
            href={githubUrl}
            rel="noopener noreferrer"
            target="_blank"
            class="link-sweep inline-flex items-center gap-1.5 font-medium text-muted hover:text-ink"
          >
            <GithubIcon class="size-4" />
            GitHub Repo
          </a>
        )}
        {liveUrl && (
          <a
            href={liveUrl}
            rel="noopener noreferrer"
            target="_blank"
            class="link-sweep inline-flex items-center gap-1.5 font-medium text-muted hover:text-ink"
          >
            Live Demo
            <ArrowUpRight class="size-4" />
          </a>
        )}
      </div>
      {tags.length > 0 && (
        <p class="mt-5 text-xs text-faint">{tags.join(" · ")}</p>
      )}
    </header>

    {(image || external) && (
      <div
        data-reveal
        class="mt-10 overflow-hidden rounded-sm border border-line"
      >
        {image ? (
          <Image
            src={image}
            alt={title}
            class="aspect-video w-full object-cover"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 768px, 100vw"
            loading="eager"
            decoding="async"
          />
        ) : (
          <img
            src={heroImage}
            alt={title}
            loading="eager"
            decoding="async"
            class="aspect-video w-full object-cover"
          />
        )}
      </div>
    )}

    <div
      data-reveal
      class="prose mt-10 max-w-none prose-headings:font-serif prose-a:font-medium"
      set:html={html}
    />
  </article>
</BaseLayout>
