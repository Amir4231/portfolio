---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Admin" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem("theme");
          d.classList.toggle("dark", t !== "light");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-surface text-ink antialiased">
    <header class="border-b border-line">
      <div
        class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6"
      >
        <a href="/" class="font-serif text-lg font-semibold text-ink">
          ← Back to site
        </a>
        <form method="post" action="/api/logout">
          <button type="submit" class="text-sm text-muted transition hover:text-accent">
            Log out
          </button>
        </form>
      </div>
    </header>
    <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
      <slot />
    </main>
  </body>
</html>
